<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080B">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mc_version_spinner">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Nomea Branding -->
            <TextView
                android:id="@+id/nomea_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMEA"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/nomea_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LAUNCHER  V2  •  PREMIUM EDITION"
                android:textColor="#E50914"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/nomea_title"/>

            <!-- Divider -->
            <View
                android:id="@+id/nomea_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#55E50914"
                app:layout_constraintTop_toBottomOf="@id/nomea_subtitle"/>

            <!-- Section Title -->
            <TextView
                android:id="@+id/menu_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="QUICK ACCESS"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/nomea_divider"/>

            <!-- Wiki -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:text="@string/mcl_tab_wiki"
                android:drawableStart="@drawable/ic_px_book"
                app:layout_constraintTop_toBottomOf="@id/menu_heading"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/social_divider"/>

            <View
                android:id="@+id/social_divider"
                style="@style/LauncherFragment_Divider"
                android:layout_marginVertical="16dp"
                app:layout_constraintTop_toTopOf="@id/news_button"
                app:layout_constraintBottom_toBottomOf="@id/news_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Telegram -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/social_media_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:text="Telegram"
                android:drawableStart="@drawable/ic_telegram"
                app:layout_constraintTop_toBottomOf="@id/menu_heading"
                app:layout_constraintStart_toEndOf="@id/social_divider"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Custom Controls -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_px_gamepad"
                android:text="@string/mcl_option_customcontrol"
                app:layout_constraintTop_toBottomOf="@id/news_button"/>

            <!-- Install Mod -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_px_java_run"
                android:text="@string/main_install_jar_file"
                app:layout_constraintTop_toBottomOf="@id/custom_control_button"/>

            <!-- Share Logs -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_px_sharelog"
                android:text="@string/main_share_logs"
                app:layout_constraintTop_toBottomOf="@id/install_jar_button"/>

            <!-- Open Files -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_px_folder"
                android:text="@string/mcl_button_open_directory"
                app:layout_constraintTop_toBottomOf="@id/share_logs_button"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:layout_constraintTop_toBottomOf="@id/open_files_button"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Version Selector -->
    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#151519"
        android:drawableEnd="@drawable/spinner_arrow"
        app:drawableEndSize="18dp"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="36dp"
        app:drawableEndPadding="4dp"
        app:layout_constraintBottom_toTopOf="@id/play_button"
        app:layout_constraintEnd_toStartOf="@id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Edit Profile -->
    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="#202024"
        android:src="@drawable/ic_px_edit"
        android:contentDescription="Edit profile"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner"/>

    <!-- Bottom Background -->
    <View
        android:id="@+id/_background_display_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#111115"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner"/>

    <!-- Play Button -->
    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="15dp"
        android:textAllCaps="true"
        android:text="▶  PLAY MINECRAFT"
        android:backgroundTint="#E50914"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
